{
  "name": "excel_manage",
  "version": "1.0.0",
  "description": "",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "set NODE_ENV=development && electron .",
    "electron:build": "vite build && electron-builder --publish never",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "com.excelmanage.crossmatch",
    "productName": "跨表匹配工具",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "element-plus": "^2.14.3",
    "vue": "^3.5.40",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
